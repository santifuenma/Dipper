{
  "name": "dipper",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:pruebas": "wrangler deploy --env pruebas",
    "test": "vitest run",
    "db:local": "wrangler d1 migrations apply dipper --local",
    "db:remote": "wrangler d1 migrations apply dipper --remote",
    "db:pruebas": "wrangler d1 migrations apply dipper-pruebas --remote --env pruebas",
    "icons": "node scripts/make-icons.mjs",
    "reset-password": "node scripts/reset-password.mjs"
  },
  "dependencies": {
    "@simplewebauthn/server": "^13.1.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.3.6",
    "@vitest/runner": "4.1.12",
    "@vitest/snapshot": "4.1.12",
    "vitest": "4.1.12",
    "wrangler": "^4.0.0"
  }
}
